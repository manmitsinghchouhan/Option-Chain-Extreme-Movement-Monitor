# ==============================================================================
# F&O Option Chain Extreme Movement Monitor - Environment Configuration
# ==============================================================================

# Telegram Bot Notification Settings (Primary Core Alerts >= ₹1.00)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Telegram Bot Notification Settings (Index Options Alerts: NIFTY 50 & SENSEX >= ₹1.00)
TELEGRAM_INDEX_CHAT_ID=your_index_group_chat_id_here
# TELEGRAM_INDEX_BOT_TOKEN=your_index_bot_token_here  # Optional: defaults to TELEGRAM_BOT_TOKEN if omitted

# Telegram Bot Notification Settings (Expiry Penny Decay Alerts < ₹1.00)
TELEGRAM_PENNY_CHAT_ID=your_penny_group_chat_id_here
# TELEGRAM_PENNY_BOT_TOKEN=your_second_bot_token_here  # Optional: defaults to TELEGRAM_BOT_TOKEN if omitted

# DhanHQ Broker API Configuration
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token